{
  "name": "vue-docx-document",
  "version": "1.0.1",
  "description": "Create Word (.docx) files with Vue 3 components: a custom Vue renderer on top of docx, for the browser and Node, with a live HTML preview.",
  "license": "MIT",
  "author": {
    "name": "Jan Tursky",
    "email": "jan.tursky@gmail.com",
    "url": "https://jantursky.com"
  },
  "homepage": "https://vue-docx-document-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jantursky/vue-docx-document.git",
    "directory": "packages/vue-docx-document"
  },
  "bugs": {
    "url": "https://github.com/jantursky/vue-docx-document/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "vue",
    "vue3",
    "docx",
    "word",
    "office",
    "openxml",
    "document",
    "renderer",
    "report",
    "invoice"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "bun run typecheck && bun run test && bun run test:browser && bun run build && bun run lint:package && bun run test:pack",
    "test:pack": "node scripts/pack-test.js",
    "size": "size-limit"
  },
  "dependencies": {
    "docx": "^9.14.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.4",
    "@size-limit/esbuild": "^14",
    "@size-limit/file": "^14",
    "@types/node": "^26",
    "@vitejs/plugin-vue": "^6",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.2",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "size-limit": "^14",
    "typescript": "~6.0.3",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^5",
    "vue": "^3.5.0",
    "vue-tsc": "^3"
  }
}
